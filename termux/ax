#!/data/data/com.termux/files/usr/bin/bash
# ArcaneXus Termux Command Center
# Extends existing XCover tools; does not replace AI engines or system services.
set -u

HOME_DIR="${HOME}"
BIN="$HOME_DIR/.local/bin"
ANX="$HOME_DIR/ArcaneXus"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# In a CI checkout there is no installed ~/ArcaneXus tree. Resolve modules
# beside this launcher only when the active device tree is absent.
if [ ! -d "$ANX/modules" ] && [ -d "$SCRIPT_DIR/modules" ]; then
  ANX="$SCRIPT_DIR"
fi
OLLAMA_URL="http://127.0.0.1:11434"

line() { printf '%s\n' '------------------------------------------------------------'; }
ok()   { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[INFO]\033[0m %s\n' "$*"; }
bad()  { printf '\033[1;31m[CHECK]\033[0m %s\n' "$*"; }


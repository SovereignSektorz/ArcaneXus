cli_version() {
  printf 'ArcaneXus XCover CLI 2.6.0\n'
  printf 'Entry: %s\n' "${BASH_SOURCE[0]}"
  printf 'Home:  %s\n' "$HOME_DIR"
  printf 'Mode:  rootless / local-first\n'
}

self_test() {
  local failures=0 f
  line
  printf 'ARCANEXUS CLI SELF-TEST / READ-ONLY\n'
  line
  for f in "$HOME_DIR/.local/bin/ax" "$HOME_DIR/bin/ax"; do
    if [ -r "$f" ] && bash -n "$f"; then ok "Shell syntax: $f"; else bad "Shell syntax: $f"; failures=$((failures+1)); fi
  done
  if python3 - "$ANX/source" <<'PYTEST'
import pathlib, sys
root=pathlib.Path(sys.argv[1])
files=list(root.glob('*.py')) + list((root.parent / 'modules').glob('*.py'))
for path in files:
    compile(path.read_text(encoding='utf-8'), str(path), 'exec')
print(f'Python syntax: {len(files)} source files passed')
PYTEST
  then :; else bad "Python source syntax check failed"; failures=$((failures+1)); fi
  for c in bash python3 curl; do
    if command -v "$c" >/dev/null 2>&1; then ok "Dependency: $c"; else bad "Missing dependency: $c"; failures=$((failures+1)); fi
  done
  for c in anx-ai-direct ax-morningstar anx-edge ax-drive ax-phone ax-modules; do
    if [ -x "$BIN/$c" ]; then ok "Helper: $c"; else warn "Optional helper missing: $c"; fi
  done
  line
  if [ "$failures" -eq 0 ]; then ok "CLI SELF-TEST PASS"; return 0; fi
  bad "$failures required check(s) failed"
  return 1
}

run_regression_tests() {
  local failures=0 base target
  if ! command -v pytest >/dev/null 2>&1; then
    bad "pytest is not installed; install it with: python -m pip install pytest"
    return 2
  fi
  line
  printf 'ARCANEXUS CORE REGRESSION SUITE / READ-ONLY\n'
  line
  # Each suite receives its own import root. This avoids false collection
  # failures caused by running unrelated source trees from one directory.
  while IFS=':' read -r base target; do
    [ -n "$target" ] || continue
    printf '\n=== %s ===\n' "$target"
    if (cd "$ANX" && PYTHONPATH="$ANX/$base:$ANX/$base/src:${PYTHONPATH:-}" python -m pytest -q "$target"); then
      ok "PASS: $target"
    else
      bad "FAIL: $target"
      failures=$((failures+1))
    fi
  done <<'SUITES'
03_EDGE_RUNTIME:03_EDGE_RUNTIME/tests
13_Release_Governance/repos/private/termux:13_Release_Governance/repos/private/termux/tests
02_Development_Environments/MorningStar/mobile-throne:02_Development_Environments/MorningStar/mobile-throne/tests
.:11_Practice_Protocol
.:00_Prime_Omega/tests
.:00_Prime_Omega/capabilities/tests
SUITES
  line
  if [ "$failures" -eq 0 ]; then
    ok "CORE REGRESSION SUITE PASS"
    return 0
  fi
  bad "$failures suite(s) failed"
  return 1
}


signin() {
  if ! command -v gh >/dev/null 2>&1; then
    bad "GitHub CLI is not installed."
    warn "Install with: pkg install gh"
    return 1
  fi
  if gh auth status >/dev/null 2>&1; then
    local account
    account="$(gh api user --jq .login 2>/dev/null || printf 'authenticated account')"
    ok "GitHub CLI already signed in as $account."
    return 0
  fi
  warn "GitHub sign-in is required for GitHub operations."
  read -r -p "Start GitHub browser sign-in now? [y/N] " confirm
  case "$confirm" in
    y|Y) gh auth login --hostname github.com --git-protocol https --web ;;
    *) warn "Sign-in deferred. No credentials changed."; return 1 ;;
  esac
}


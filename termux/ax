  line
  printf 'ARCANEXUS FIRST LAUNCH / XCOVER\n'
  line
  printf 'Device: '
  getprop ro.product.model 2>/dev/null || printf 'Android\n'
  printf 'Runtime: rootless Termux / local-first\n'
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    local account
    account="$(gh api user --jq .login 2>/dev/null || printf 'authenticated')"
    ok "GitHub sign-in: $account"
  else
    warn "GitHub sign-in: not active; run ax signin"
  fi
  if [ -f "$ANX/runtime/state/node-identity.json" ]; then
    local enrollment
    enrollment="$(python3 - "$ANX/runtime/state/node-identity.json" <<'PYID'
import json,sys
try:
 d=json.load(open(sys.argv[1]))
 print(d.get('public_identity','UNKNOWN'))
except Exception:
 print('UNREADABLE')
PYID
)"
    if [ "$enrollment" = "ENROLLED" ] || [ "$enrollment" = "VERIFIED" ]; then
      ok "Device enrollment: $enrollment"
    else
      warn "Device enrollment: $enrollment (remote trust remains blocked)"
    fi
  else
    warn "Device enrollment record missing."
  fi
  if local_api >/dev/null; then
    ok "Local Ollama API: online; no model launch requested."
  else
    warn "Local Ollama API: offline; start manually with ax start."
  fi
  if [ -x "$BIN/anx-edge" ] && "$BIN/anx-edge" staging-status >/dev/null 2>&1; then
    ok "Read-only staging edge: online on loopback."
  else
    warn "Read-only staging edge: offline."
  fi
  if command -v rclone >/dev/null 2>&1; then
    if rclone listremotes 2>/dev/null | grep -qx 'gdrive:'; then
      ok "Google Drive remote: configured; intake remains read-only."
    else
      warn "Google Drive remote: not configured."
    fi
  fi
  warn "Mesh: not activated by ignition. Run ax network mesh for a read-only reachability check."
  warn "Production port 1121 remains closed. No sync, device actuation, or remote execution is started."
  line
  printf 'Opening the ArcaneXus command center.\n'
  menu
}

case "${1:-menu}" in
  write) shift; exec "$BIN/ax-code" write "$@" ;;
  fixfile) shift; exec "$BIN/ax-code" fixfile "$@" ;;
  review) exec "$BIN/ax-code" review ;;
  apply) exec "$BIN/ax-code" apply ;;
  talk) exec "$BIN/ax-morningstar" talk ;;
  think) shift; exec "$BIN/ax-morningstar" think "$@" ;;
  diagnose) exec "$BIN/ax-morningstar" diagnose ;;
  repair) exec "$BIN/ax-morningstar" repair ;;
  approve) exec "$BIN/ax-morningstar" approve ;;
  teach) shift; exec "$BIN/ax-morningstar" teach "$@" ;;
  history) exec "$BIN/ax-morningstar" history ;;
  menu|ui) menu ;;
  ignite|first-launch) first_launch ;;
  signin|login) signin ;;
  version|-V|--version) cli_version ;;
  test) run_regression_tests ;;
  self-test) self_test ;;
  ops) shift; exec python3 "$ANX/scripts/ax_ops.py" "$@" ;;
  policy) shift; exec python3 "$ANX/scripts/ax_policy.py" "$@" ;;
  quick) status ;;
  help|-h|--help) help_text ;;
  learn|tutorial) shift; tutorial "${1:-list}" ;;
  ai|chat)
    if [ "$#" -gt 1 ]; then shift; exec "$BIN/anx-ai-direct" "$@"; fi
    exec "$BIN/anx-ai-direct" --chat ;;
  ask) shift; [ "$#" -gt 0 ] || { echo 'Usage: ax ask "your question"'; exit 2; }; exec "$BIN/anx-ai-direct" "$@" ;;
  code) shift; [ "$#" -gt 0 ] || { echo 'Usage: ax code "your coding task"'; exit 2; }; exec "$BIN/anx-ai-direct" --code "$@" ;;
  models|model) exec "$BIN/ai-models" ;;
  phone) shift; exec "$BIN/ax-phone" "$@" ;;
  provider) shift; exec "$BIN/ax-provider" "$@" ;;
  drive) shift; exec "$BIN/ax-drive" "$@" ;;
  modules) shift; exec "$BIN/ax-modules" "$@" ;;
  tools) exec python3 "$ANX/modules/integrations.py" tools ;;
  skills) exec python3 "$ANX/modules/integrations.py" skills ;;
  integrations) shift; exec python3 "$ANX/modules/integrations.py" "${1:-all}" ;;
  convergence) shift; exec python3 "$ANX/modules/convergence.py" "$@" ;;
  state-guard) shift; exec python3 "$ANX/modules/state_guard.py" "$@" ;;
  state-guard-macro) shift; exec python3 "$ANX/modules/state_guard_macro.py" "$@" ;;
  state-guard-pipeline) shift; exec python3 "$ANX/modules/state_guard_pipeline.py" "$@" ;;
  broker) shift; exec python3 "$ANX/modules/broker.py" "$@" ;;
  bounty-score) shift; exec python3 "$ANX/modules/bounty_score.py" "$@" ;;
  bounty)
    shift
    case "${1:-}" in
      discover|list|config-check|sync|verify|pipeline) exec python3 "$ANX/modules/bounty_automation.py" "$@" ;;
      *) exec python3 "$ANX/modules/bounty_score.py" "$@" ;;
    esac ;;
  jobs|git-jobs) shift; exec python3 "$ANX/modules/bounty_automation.py" "$@" ;;
  connect)
    shift
    case "${1:-}" in
      home) exec "$BIN/ax-home" ssh ;;
      chatgpt|gemini) exec "$BIN/ax-provider" connect "$1" ;;
      drive) exec "$BIN/ax-drive" connect ;;
      *) echo "Usage: ax connect [home|chatgpt|gemini|drive]"; exit 2 ;;
    esac ;;
  disconnect)
    shift
    case "${1:-}" in
      home) echo "Close the active SSH session by typing: exit" ;;
      providers|chatgpt|gemini) exec "$BIN/ax-provider" disconnect ;;
      drive) exec "$BIN/ax-drive" disconnect ;;
      *) echo "Usage: ax disconnect [home|providers|chatgpt|gemini|drive]"; exit 2 ;;
    esac ;;
  edge) shift; exec "$BIN/anx-edge" "${1:-status}" ;;
  status) status ;;
  doctor) doctor ;;
  start) start_ollama ;;
  fix) fix_menu ;;
  logs) logs ;;
  backup) backup ;;
  update) update_packages ;;
  voice) shift; exec "$BIN/ax-voice" "${1:-once}" ;;
  audit) exec "$BIN/anx-status" ;;
  sync) exec "$BIN/anx-sync" ;;
  network) shift; exec python3 "$ANX/source/anx_network_preflight.py" "${1:-doctor}" ;;
  home) shift; exec "$BIN/ax-home" "${1:-check}" ;;
  verify) exec python3 "$ANX/source/xcover_verify.py" ;;
  *) echo "Unknown command: $1"; echo; help_text; exit 2 ;;
esac
